{
  "name": "okr-master",
  "version": "1.4.0",
  "private": true,
  "description": "A local, file-based OKR planning and review desktop application.",
  "author": "OKR Master",
  "type": "module",
  "main": "dist-electron/main.cjs",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "concurrently -k \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "tsx watch src/server/index.ts",
    "dev:client": "vite",
    "build": "npm run typecheck && vite build",
    "build:cloud": "npm run typecheck && vite build --mode cloud",
    "build:electron": "esbuild src/desktop/main.ts --bundle --platform=node --format=cjs --external:electron --outfile=dist-electron/main.cjs",
    "build:desktop": "npm run build && npm run build:electron && npm run build:viewer-assets",
    "desktop:dev": "npm run build:desktop && electron .",
    "package:windows": "npm run build:desktop && electron-builder --win --dir",
    "build:viewer-assets": "vite build --config vite.viewer.config.ts && node scripts/inline-viewer-assets.mjs",
    "build:viewer": "npm run build:viewer-assets && tsx scripts/export-viewer.ts",
    "package:mac": "npm run build:desktop && electron-builder --mac dmg zip",
    "icons": "electron scripts/generate-icons.cjs",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-sqlite ./node_modules/vitest/vitest.mjs run",
    "start": "tsx src/server/index.ts"
  },
  "dependencies": {
    "express": "^5.1.0",
    "jose": "^6.2.17",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "worker-mailer": "^1.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^22.15.30",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^9.2.0",
    "electron": "^44.7.2",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "vite": "^6.4.0",
    "vitest": "^5.0.3",
    "wrangler": "^4.161.0"
  },
  "build": {
    "appId": "com.sensirion.okrmaster",
    "productName": "OKR Master",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "dist-viewer/**/*",
      "build/icon.png",
      "package.json"
    ],
    "win": {
      "icon": "build/icon.png",
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "mac": {
      "icon": "build/icon.png",
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.productivity",
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    }
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
